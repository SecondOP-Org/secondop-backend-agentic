# Server Configuration
NODE_ENV=development
# Local default 8081 — macOS AirPlay Receiver often occupies 5000; Presidio compose uses 5001/5002.
PORT=8081
API_VERSION=v1

# Safe release/build metadata exposed by /health and /version.
# Values are public identifiers only; never place secrets in these fields.
SECONDOP_RELEASE_VERSION=0.0.0-dev
BACKEND_GIT_SHA=unknown
BACKEND_BUILD_TIME=unknown
BACKEND_DEPLOYMENT_ID=local

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secondop_db
DB_USER=postgres
# Must match docker compose POSTGRES_PASSWORD (default below).
# If auth fails after changing this, recreate the volume: docker compose down -v && docker compose up -d postgres
DB_PASSWORD=postgres
DB_SSL=false
# Optional when DB_SSL=true. Use either inline CA text or a local CA file path
# when your database certificate is not trusted by the system trust store.
DB_SSL_CA=
DB_SSL_CA_FILE=
# Keep true in production. false is allowed only for local/non-production debugging.
DB_SSL_REJECT_UNAUTHORIZED=true

# Demo accounts bootstrap (default on). Set false to disable demo doctor/patient seeding on startup.
ENSURE_DEMO_DATA=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN=http://localhost:8080
# Production example (primary +.in during redirect cutover):
# CORS_ORIGIN=https://secondop.ai,https://secondop.in
# SOCKET_IO_CORS_ORIGIN=https://secondop.ai,https://secondop.in
# APP_PUBLIC_URL=https://secondop.ai

# File Upload Configuration
MAX_FILE_SIZE=52428800
# Whole imaging study ingest (zip or folder of DICOM instances)
MAX_STUDY_SIZE=1073741824
MAX_STUDY_FILES=2000
UPLOAD_DIR=./uploads
# Production (Railway Volume): UPLOAD_DIR=/data/uploads

# Email Configuration (Nodemailer SMTP — Resend/SendGrid/SES/Gmail all work)
# Leave SMTP_HOST empty to disable outbound email (auth still works; sends are skipped).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=SecondOp <noreply@secondop.ai>
# Optional SMTP timeouts (ms). Keep short so auth APIs stay responsive.
# SMTP_CONNECTION_TIMEOUT_MS=8000
# SMTP_SOCKET_TIMEOUT_MS=10000
# SMTP_SEND_TIMEOUT_MS=12000
# Public frontend origin used in verify/reset links
APP_PUBLIC_URL=http://localhost:8080
# FRONTEND_URL is accepted as a fallback for APP_PUBLIC_URL
# FRONTEND_URL=http://localhost:8080
# Public API origin for one-click signup approve/reject links (SEC-199).
# Production example: https://secondop-backend-production.up.railway.app
# API_PUBLIC_URL=http://localhost:8081

# Signup gate (SEC-199) — by-request beta.
# Default: required when NODE_ENV=production. Set false to open signup; true to force gate locally.
# SIGNUP_REQUIRES_APPROVAL=true
# Ops inbox for new signup approval requests (default vinodhpeddi@gmail.com)
# SIGNUP_APPROVAL_NOTIFY_EMAIL=vinodhpeddi@gmail.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Configuration (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# WebSocket/Socket.IO
SOCKET_IO_CORS_ORIGIN=http://localhost:8080

# AI/ML Services (Optional)
# Direct mode remains the default. LiteLLM mode routes OpenAI-compatible calls
# through the local/provisioned LiteLLM Proxy using a LiteLLM virtual key.
LLM_GATEWAY_MODE=direct
LLM_GATEWAY_BASE_URL=http://localhost:4000
LLM_GATEWAY_API_KEY=
# Provider key: used directly by the backend in direct mode, and by LiteLLM
# as provider credentials when running the local ai-gateway profile.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODEL=
OPENAI_TIMEOUT_MS=60000
# LiteLLM master key: admin key for LiteLLM UI/key generation. Do not use this
# as the backend app key; generate a virtual key and set LLM_GATEWAY_API_KEY.
LITELLM_MASTER_KEY=
LITELLM_DATABASE_URL=postgresql://litellm:litellm@litellm-postgres:5432/litellm
ANALYSIS_MAX_CHARS_PER_FILE=12000
ANALYSIS_MAX_TOTAL_CHARS=30000
# Hybrid OCR for scanned PDFs and image reports
OCR_ENABLED=true
OCR_TEXTRACT_ENABLED=true
OCR_VISION_FALLBACK_ENABLED=true
OCR_VISION_MODEL=gpt-4o
OCR_MIN_CHARS=40
OCR_TEXTRACT_MIN_CONFIDENCE=0.75
OCR_VISION_FALLBACK_MAX_PAGES=10
AI_SERVICE_URL=http://localhost:8000

# PII/PHI de-identification (Microsoft Presidio sidecars)
# Ship dark by default. Enable after: docker compose --profile deid up -d
DEID_ENABLED=false
PRESIDIO_ANALYZER_URL=http://localhost:5002
PRESIDIO_ANONYMIZER_URL=http://localhost:5001
PRESIDIO_MIN_SCORE=0.5
PRESIDIO_TIMEOUT_MS=10000
PRESIDIO_LANGUAGE=en
# Optional: AES key material for sealing token→value maps at rest (Phase 2)
DEID_REVERSIBLE_KEY=

# DICOM header PHI de-identification on ingest (independent of Presidio sidecars).
# Requires DEID_REVERSIBLE_KEY when enabled.
DICOM_DEID_ENABLED=false

# Burned-in pixel PHI redaction (Presidio image-redactor sidecar). Ship dark.
# When true: redact image/US-SC pixels BEFORE storage and before vision-OCR;
# fail closed if the redactor is unreachable (no raw pixels leave the boundary).
# Plain CT/MR skip pixel OCR (tag de-id only). Irreversible — no un-redacted original retained.
IMAGE_DEID_ENABLED=false
PRESIDIO_IMAGE_REDACTOR_URL=http://localhost:5003
# PRESIDIO_IMAGE_REDACTOR_PORT=5003
PRESIDIO_IMAGE_REDACTOR_TIMEOUT_MS=60000
# Comma-separated DICOM modalities that receive pixel redaction (plus RGB/photographic).
DICOM_PIXEL_REDACT_MODALITIES=US,SC,XC,OT

# baseline: baseline pipeline only | shadow: baseline user output + agentic evaluation | agentic: agentic user output
ANALYSIS_EXECUTION_MODE=agentic
# Deprecated alias for ANALYSIS_EXECUTION_MODE (off->baseline, shadow->shadow, direct->agentic)
ANALYSIS_AGENTIC_MODE=direct
ANALYSIS_PIPELINE_VERSION=1.0.0
ANALYSIS_PROMPT_VERSION=case-analysis-v1
AGENTIC_MODEL=gpt-4.1-mini
AGENTIC_PLANNER_FALLBACK_MODEL=
AGENTIC_MAX_STEPS=10
AGENTIC_MAX_REFINEMENTS=1
# Supported: native | langchain. Unsupported values fail startup (SEC-14).
AGENTIC_RUNTIME=native
# When AGENTIC_RUNTIME=langchain: allow silent fall back to native on LangGraph errors.
AGENTIC_LANGCHAIN_ALLOW_FALLBACK=true
LANGGRAPH_CHECKPOINT_SCHEMA=public
ANALYSIS_QUEUE_NAME=case-analysis-baseline
ANALYSIS_QUEUE_SCHEMA=pgboss

# Clinical grounding (SEC-206) — external PubMed / ClinicalTrials / RxNorm lookups.
# Ship dark: leave false until staged rollout. When false, grounding tools are not registered.
GROUNDING_ENABLED=false
# Optional NCBI API key raises PubMed E-utilities rate limit (~10 req/s vs ~3).
NCBI_API_KEY=
# Specialty allowlist for ClinicalTrials.gov tool (CSV, lowercase hyphenated).
CLINICAL_TRIALS_SPECIALTY_ALLOWLIST=oncology,hematology-oncology,rare-disease,medical-genetics
# Hard timeout (ms) for each external grounding HTTP call.
GROUNDING_HTTP_TIMEOUT_MS=5000

# Patient records-connect (SEC-216 / FE §5). Ship dark — set true for sandbox demos.
RECORDS_CONNECT_ENABLED=false
# Provider adapter: synthea_mock (default) | metriport (future)
RECORDS_CONNECT_PROVIDER=synthea_mock
# Mock provider delay before status flips pending → complete (ms)
RECORDS_CONNECT_MOCK_DELAY_MS=1500

# Dev-only auth bypass (never enable in production)
DEV_SKIP_AUTH=false
DEV_SKIP_AUTH_USER_TYPE=patient
# Optional: force a specific existing users.id
DEV_SKIP_AUTH_USER_ID=

# Command center operator access
# Comma-separated allowlists for /api/v1/admin/command-center and /api/v1/admin/service-health.
# Keep empty until an explicit admin/operator user is selected.
COMMAND_CENTER_OPERATOR_USER_IDS=
COMMAND_CENTER_OPERATOR_EMAILS=
# Optional sanitized ledger paths. Defaults to docs/AGENT_RUN_LEDGER.md for backend.
COMMAND_CENTER_BACKEND_LEDGER_PATH=
COMMAND_CENTER_FRONTEND_LEDGER_PATH=

# Service Health dashboard (operator-only GET /api/v1/admin/service-health)
# Optional JSON catalog of public URLs to probe for staging + production.
# When unset, built-in production defaults + staging backend URL are used.
# Example:
# SERVICE_HEALTH_TARGETS={"production":[{"id":"fe","label":"Frontend","url":"https://secondop.ai","probe":"http"},{"id":"api","label":"Backend API","url":"https://secondop-backend-production.up.railway.app","probe":"backend_health"}],"staging":[{"id":"api","label":"Backend API","url":"https://secondop-backend-staging-staging.up.railway.app","probe":"backend_health"}]}
SERVICE_HEALTH_TARGETS=
# Optional label for "this" deploy (falls back to RAILWAY_ENVIRONMENT_NAME / NODE_ENV)
SECONDOP_DEPLOY_ENV=

# Analysis SLO / fail-closed alerts (optional; Slack-compatible incoming webhook)
# Posts { "text": "..." } when:
# - trailing 20 runs success rate < 95%
# - trailing p95 latency > 180s
# - any fail-closed event (Presidio/de-id halt / PHI guard) — immediate, no threshold
ALERT_WEBHOOK_URL=

# Per-case latency warn threshold (ms). Flags attention_reason=slow when exceeded (SEC-122/PC3).
# Independent of fleet p95 alerting; default 180000 (3 minutes).
PER_CASE_LATENCY_WARN_MS=180000

# Arize Phoenix Observability (Optional locally; production uses Railway secondop-phoenix)
# See docs/PHOENIX_TRACING.md
PHOENIX_ENABLED=false
PHOENIX_PROJECT_NAME=secondop-agent-analysis
PHOENIX_COLLECTOR_URL=http://localhost:6006
PHOENIX_API_KEY=
